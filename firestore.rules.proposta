// PROPOSTA — NÃO FAZER DEPLOY. Revisar antes de substituir firestore.rules.
//
// Quem acessa: só membros da Turma B.
// - /members/{email} (e-mail em minúsculas como id) lista quem é da turma. Como
//   /leaders, só se escreve pelo console (ou pelo script de uso único).
// - Toda leitura e escrita de conteúdo e de progresso exige e-mail Insper
//   verificado E documento em /members. Líder também precisa estar em /members.
//
// Como o papel de líder é validado no backend:
// - O login real (Firebase Auth com conta Google do Insper) entrega request.auth
//   com o e-mail verificado do usuário.
// - Os líderes são cadastrados à mão no console do Firebase, na coleção
//   /leaders/{uid} (um documento vazio por líder). Nenhum cliente consegue
//   escrever nessa coleção, então ninguém se promove a líder pelo site.
// - Toda escrita de conteúdo checa isLeader() aqui. Esconder botões no site é só
//   conveniência: um aluno que chame a API direto é barrado aqui.
// - Nada é apagado de verdade pelo app: "apagar" grava deletedAt (lixeira).
//
// Progresso individual ("eu já fiz"):
// - /progress/{uid} guarda { done: { [activityId]: true } }; só o dono lê e escreve.
// - O app grava o progresso e o doneCount da atividade num único writeBatch.
//   As duas regras abaixo se conferem com getAfter/existsAfter: o progresso só
//   muda se o doneCount daquela atividade mudar ±1 no mesmo batch, e vice-versa.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Quem é quem ----------

    // Logado com e-mail verificado do Insper (aluno ou professor).
    function isInsper() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@(al[.])?insper[.]edu[.]br');
    }

    // E-mail do token em minúsculas: é o id do documento em /members.
    function email() {
      return request.auth.token.email.lower();
    }

    // Membro = usuário do Insper cujo e-mail está em /members.
    function isMember() {
      return isInsper()
        && exists(/databases/$(database)/documents/members/$(email()));
    }

    // Líder = membro com documento em /leaders/{uid}.
    function isLeader() {
      return isMember()
        && exists(/databases/$(database)/documents/leaders/$(request.auth.uid));
    }

    // ---------- Validação comum ----------

    function isDate(value) {
      return value is string && value.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
    }

    // Texto com tamanho entre min e max caracteres.
    function isText(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    // Campos de controle presentes em todo documento de conteúdo.
    function hasTimestamps(data) {
      return data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (data.deletedAt == null || data.deletedAt is timestamp);
    }

    // Criação: timestamps do servidor e começa fora da lixeira.
    function isValidCreate() {
      return isLeader()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.deletedAt == null;
    }

    // Edição por líder: createdAt fixo, updatedAt do servidor; deletedAt só pode
    // ficar igual, ir para a lixeira (= agora) ou ser restaurado (null).
    function isValidLeaderUpdate() {
      let before = resource.data;
      let after = request.resource.data;
      return isLeader()
        && after.createdAt == before.createdAt
        && after.updatedAt == request.time
        && (after.deletedAt == before.get('deletedAt', null)
          || after.deletedAt == null
          || after.deletedAt == request.time);
    }

    // Membros só leem o que não está na lixeira; líderes leem tudo.
    // (O app consulta com where('deletedAt', '==', null) quando não é líder.)
    function canRead() {
      return isLeader() || (isMember() && resource.data.deletedAt == null);
    }

    // ---------- Atividades ----------

    function validActivity(data) {
      return data.keys().hasOnly(['title', 'subject', 'dueDate', 'doneCount', 'deletedAt', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['title', 'subject', 'dueDate', 'doneCount', 'deletedAt', 'createdAt', 'updatedAt'])
        && isText(data.title, 3, 120)
        && data.subject in ['GDE', 'DesSoft', 'InstruMed', 'DesProd', 'Tópicos', 'ModSim']
        && isDate(data.dueDate)
        && data.doneCount is int && data.doneCount >= 0
        && hasTimestamps(data);
    }

    // Documento de progresso do usuário logado, antes e depois da escrita.
    function progressPath() {
      return /databases/$(database)/documents/progress/$(request.auth.uid);
    }

    function doneBefore() {
      return exists(progressPath()) ? get(progressPath()).data.done : {};
    }

    function doneAfter() {
      return existsAfter(progressPath()) ? getAfter(progressPath()).data.done : {};
    }

    // "Eu já fiz": só o doneCount muda, exatamente ±1, e o progresso do próprio
    // usuário muda no mesmo batch (marca com +1, desmarca com -1).
    function isProgressCount(activityId) {
      let oldCount = resource.data.get('doneCount', 0);
      let newCount = request.resource.data.doneCount;
      return isMember()
        && resource.data.get('deletedAt', null) == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['doneCount'])
        && newCount is int
        && newCount >= 0
        && ((newCount == oldCount + 1 && !(activityId in doneBefore()) && activityId in doneAfter())
          || (newCount == oldCount - 1 && activityId in doneBefore() && !(activityId in doneAfter())));
    }

    match /activities/{activityId} {
      allow read: if canRead();
      allow create: if isValidCreate()
        && validActivity(request.resource.data)
        && request.resource.data.doneCount == 0;
      // Líder edita o conteúdo (o doneCount não pode ser mexido por aqui) ou
      // qualquer membro registra o próprio "eu já fiz".
      allow update: if (isValidLeaderUpdate()
          && validActivity(request.resource.data)
          && request.resource.data.doneCount == resource.data.doneCount)
        || isProgressCount(activityId);
      // Exclusão definitiva só pelo console (o app usa a lixeira).
      allow delete: if false;
    }

    // ---------- Progresso individual ----------

    // A atividade mudou o doneCount em `step` no mesmo batch.
    function countMoved(activityId, step) {
      let path = /databases/$(database)/documents/activities/$(activityId);
      return exists(path)
        && getAfter(path).data.get('doneCount', 0) == get(path).data.get('doneCount', 0) + step;
    }

    // Cada escrita muda exatamente uma atividade no mapa done (marca ou desmarca)
    // e precisa vir junto com o doneCount correspondente.
    function validProgressWrite() {
      let before = resource == null ? {} : resource.data.done;
      let after = request.resource.data.done;
      let added = after.keys().removeAll(before.keys());
      let removed = before.keys().removeAll(after.keys());
      return request.resource.data.keys().hasOnly(['done'])
        && after is map
        && after.values().hasOnly([true])
        && ((added.size() == 1 && removed.size() == 0 && countMoved(added[0], 1))
          || (added.size() == 0 && removed.size() == 1 && countMoved(removed[0], -1)));
    }

    match /progress/{uid} {
      // Ninguém lê nem escreve o progresso de outra pessoa (nem líderes).
      allow read: if isMember() && request.auth.uid == uid;
      allow create, update: if isMember() && request.auth.uid == uid && validProgressWrite();
      allow delete: if false;
    }

    // ---------- Avisos ----------

    function validNotice(data) {
      return data.keys().hasOnly(['title', 'body', 'source', 'sourceDetail', 'date', 'pinned', 'deletedAt', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['title', 'body', 'source', 'sourceDetail', 'date', 'pinned', 'deletedAt', 'createdAt', 'updatedAt'])
        && isText(data.title, 3, 120)
        && isText(data.body, 1, 2000)
        && data.source in ['lideres', 'professor']
        && isText(data.sourceDetail, data.source == 'professor' ? 2 : 0, 80)
        && isDate(data.date)
        && data.pinned is bool
        && hasTimestamps(data);
    }

    match /notices/{noticeId} {
      allow read: if canRead();
      allow create: if isValidCreate() && validNotice(request.resource.data);
      allow update: if isValidLeaderUpdate() && validNotice(request.resource.data);
      allow delete: if false;
    }

    // ---------- Eventos ----------

    function validEvent(data) {
      return data.keys().hasOnly(['type', 'title', 'description', 'date', 'link', 'deletedAt', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['type', 'title', 'description', 'date', 'link', 'deletedAt', 'createdAt', 'updatedAt'])
        && data.type in ['lab', 'workshop', 'vaga', 'outro']
        && isText(data.title, 3, 120)
        && isText(data.description, 1, 280)
        && isDate(data.date)
        // Link vazio ou http(s); bloqueia javascript:, data: etc.
        && isText(data.link, 0, 500)
        && (data.link == '' || data.link.matches('https?://.+'))
        && hasTimestamps(data);
    }

    match /events/{eventId} {
      allow read: if canRead();
      allow create: if isValidCreate() && validEvent(request.resource.data);
      allow update: if isValidLeaderUpdate() && validEvent(request.resource.data);
      allow delete: if false;
    }

    // ---------- Membros e líderes ----------

    // Cada usuário só confere o próprio e-mail (o app usa isso para saber se é da
    // turma); ninguém lista os e-mails da turma nem escreve pelo app.
    match /members/{memberEmail} {
      allow get: if isInsper() && memberEmail == email();
      allow list, write: if false;
    }


    // Cada usuário só lê o próprio documento; escrita só pelo console do Firebase.
    match /leaders/{uid} {
      allow read: if isInsper() && request.auth.uid == uid;
      allow write: if false;
    }

    // Qualquer outro caminho fica bloqueado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
