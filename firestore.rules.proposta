// PROPOSTA — NÃO FAZER DEPLOY. Revisar antes de substituir firestore.rules.
//
// Modelo (várias turmas e semestres):
//   /admins/{email}                     quem administra o site (só pelo console)
//   /usuarios/{email}                   { turmas: [idDaTurma, ...] } — escrito pelos admins
//   /turmas/{t}                         { nome, semestre, materias, tamanho, arquivada, ... }
//   /turmas/{t}/membros/{email}         { papel: 'aluno' | 'lider' } — escrito pelos admins
//   /turmas/{t}/activities|notices|events|opportunities|files/{id}   conteúdo
//   /turmas/{t}/progress/{uid}          { done: { [idDaAtividade]: true } } — só o dono
//
// E-mails sempre em minúsculas como id de documento.
// - Admin: gerencia turmas, semestres, membros e líderes pelo painel do site. Não
//   escreve conteúdo (para isso, se coloca como líder da turma).
// - Líder: escreve o conteúdo da turma e edita a lista de matérias.
// - Aluno: lê o conteúdo e marca o próprio "eu já fiz".
// - Turma arquivada (semestre encerrado): todos leem, ninguém escreve conteúdo.
// - Nada é apagado pelo app: "apagar" grava deletedAt (lixeira de 7 dias).
//
// Login: conta Microsoft/Outlook do Insper. ATENÇÃO: com o provedor microsoft.com o
// token pode vir com email_verified == false; conferir no primeiro login real e,
// se for o caso, trocar a checagem por sign_in_provider == 'microsoft.com'.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Quem é quem ----------

    function isInsper() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@(al[.])?insper[.]edu[.]br');
    }

    function email() {
      return request.auth.token.email.lower();
    }

    function isAdmin() {
      return isInsper() && exists(/databases/$(database)/documents/admins/$(email()));
    }

    function membroPath(t) {
      return /databases/$(database)/documents/turmas/$(t)/membros/$(email());
    }

    function isMember(t) {
      return isInsper() && exists(membroPath(t));
    }

    function isLeader(t) {
      return isMember(t) && get(membroPath(t)).data.papel == 'lider';
    }

    function turma(t) {
      return get(/databases/$(database)/documents/turmas/$(t)).data;
    }

    // Turma aberta = semestre em andamento (aceita escrita de conteúdo).
    function isOpen(t) {
      return turma(t).arquivada == false;
    }

    // ---------- Validação comum ----------

    function isDate(value) {
      return value is string && value.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
    }

    // Horário opcional HH:MM (24h); "" = sem horário.
    function isTime(value) {
      return value is string && (value == '' || value.matches('([01][0-9]|2[0-3]):[0-5][0-9]'));
    }

    function hasExactly(data, keys) {
      return data.keys().hasOnly(keys) && data.keys().hasAll(keys);
    }

    function isText(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    // Link vazio (se permitido) ou http(s); bloqueia javascript:, data: etc.
    function isLink(value, required) {
      return isText(value, required ? 1 : 0, 500) && (value == '' ? !required : value.matches('https?://.+'));
    }

    function isEmail(value) {
      return value.matches('[^@ ]+@(al[.])?insper[.]edu[.]br');
    }

    function hasTimestamps(data) {
      return data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (data.deletedAt == null || data.deletedAt is timestamp);
    }

    // Criação de conteúdo: líder, turma aberta, timestamps do servidor, fora da lixeira.
    function isValidCreate(t) {
      return isLeader(t)
        && isOpen(t)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.deletedAt == null;
    }

    // Edição por líder: createdAt fixo, updatedAt do servidor; deletedAt só fica igual,
    // vai para a lixeira (= agora) ou é restaurado (null).
    function isValidLeaderUpdate(t) {
      let before = resource.data;
      let after = request.resource.data;
      return isLeader(t)
        && isOpen(t)
        && after.createdAt == before.createdAt
        && after.updatedAt == request.time
        && (after.deletedAt == before.get('deletedAt', null)
          || after.deletedAt == null
          || after.deletedAt == request.time);
    }

    // Membros só leem o que não está na lixeira; líderes leem tudo.
    // (O app consulta com where('deletedAt', '==', null) quando não é líder.)
    function canRead(t) {
      return isLeader(t) || (isMember(t) && resource.data.deletedAt == null);
    }

    // Matéria válida: está na lista da turma ou é a que o item já tinha (uma matéria
    // removida da lista não impede editar o título de uma atividade antiga).
    function isSubject(t, value, allowEmpty) {
      return (allowEmpty && value == '')
        || value in turma(t).materias
        || (resource != null && value == resource.data.get('subject', null));
    }

    // ---------- Admins e usuários ----------

    match /admins/{adminEmail} {
      allow get: if isInsper() && adminEmail == email();
      allow list, write: if false;
    }

    match /usuarios/{userEmail} {
      allow get: if isInsper() && (userEmail == email() || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && isEmail(userEmail)
        && hasExactly(request.resource.data, ['turmas'])
        && request.resource.data.turmas is list
        && request.resource.data.turmas.size() <= 20;
      allow delete: if isAdmin();
    }

    // ---------- Turmas ----------

    function isValidTurma(data) {
      return hasExactly(data, ['nome', 'semestre', 'materias', 'tamanho', 'arquivada', 'createdAt', 'updatedAt'])
        && isText(data.nome, 2, 60)
        && data.semestre is string && data.semestre.matches('[0-9]{4}[.][12]')
        && data.materias is list && data.materias.size() >= 1 && data.materias.size() <= 20
        && data.tamanho is int && data.tamanho >= 0 && data.tamanho <= 500
        && data.arquivada is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /turmas/{t} {
      allow read: if isAdmin() || isMember(t);
      allow create: if isAdmin()
        && isValidTurma(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      // Admin edita tudo (menos createdAt); líder só a lista de matérias, com a turma aberta.
      allow update: if isValidTurma(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && (isAdmin()
          || (isLeader(t)
            && resource.data.arquivada == false
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['materias', 'updatedAt'])));
      allow delete: if false;

      // Cada membro lê o próprio papel; o admin lê e escreve a lista toda.
      match /membros/{memberEmail} {
        allow get: if isAdmin() || (isInsper() && memberEmail == email());
        allow list: if isAdmin();
        allow create, update: if isAdmin()
          && isEmail(memberEmail)
          && hasExactly(request.resource.data, ['papel'])
          && request.resource.data.papel in ['aluno', 'lider'];
        allow delete: if isAdmin();
      }

      // ---------- Atividades ----------

      function isValidActivity(data) {
        // dueTime é opcional: atividades antigas não têm o campo.
        return data.keys().hasOnly(['title', 'subject', 'dueDate', 'dueTime', 'doneCount', 'deletedAt', 'createdAt', 'updatedAt'])
          && data.keys().hasAll(['title', 'subject', 'dueDate', 'doneCount', 'deletedAt', 'createdAt', 'updatedAt'])
          && isTime(data.get('dueTime', ''))
          && isText(data.title, 3, 120)
          && isSubject(t, data.subject, false)
          && isDate(data.dueDate)
          && data.doneCount is int && data.doneCount >= 0
          && hasTimestamps(data);
      }

      function progressPath() {
        return /databases/$(database)/documents/turmas/$(t)/progress/$(request.auth.uid);
      }

      function doneBefore() {
        return exists(progressPath()) ? get(progressPath()).data.done : {};
      }

      function doneAfter() {
        return existsAfter(progressPath()) ? getAfter(progressPath()).data.done : {};
      }

      // "Eu já fiz": só o doneCount muda, exatamente ±1, junto com o progresso do
      // próprio usuário no mesmo batch.
      function isProgressCount(activityId) {
        let oldCount = resource.data.get('doneCount', 0);
        let newCount = request.resource.data.doneCount;
        return isMember(t)
          && isOpen(t)
          && resource.data.get('deletedAt', null) == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['doneCount'])
          && newCount is int
          && newCount >= 0
          && ((newCount == oldCount + 1 && !(activityId in doneBefore()) && activityId in doneAfter())
            || (newCount == oldCount - 1 && activityId in doneBefore() && !(activityId in doneAfter())));
      }

      match /activities/{activityId} {
        allow read: if canRead(t);
        allow create: if isValidCreate(t)
          && isValidActivity(request.resource.data)
          && request.resource.data.doneCount == 0;
        allow update: if (isValidLeaderUpdate(t)
            && isValidActivity(request.resource.data)
            && request.resource.data.doneCount == resource.data.doneCount)
          || isProgressCount(activityId);
        allow delete: if false;
      }

      // ---------- Progresso individual ----------

      function countMoved(activityId, step) {
        let path = /databases/$(database)/documents/turmas/$(t)/activities/$(activityId);
        return exists(path)
          && getAfter(path).data.get('doneCount', 0) == get(path).data.get('doneCount', 0) + step;
      }

      function isValidProgressWrite() {
        let before = resource == null ? {} : resource.data.done;
        let after = request.resource.data.done;
        let added = after.keys().removeAll(before.keys());
        let removed = before.keys().removeAll(after.keys());
        return request.resource.data.keys().hasOnly(['done'])
          && after is map
          && after.values().hasOnly([true])
          && ((added.size() == 1 && removed.size() == 0 && countMoved(added[0], 1))
            || (added.size() == 0 && removed.size() == 1 && countMoved(removed[0], -1)));
      }

      match /progress/{uid} {
        allow read: if isMember(t) && request.auth.uid == uid;
        allow create, update: if isMember(t) && isOpen(t) && request.auth.uid == uid && isValidProgressWrite();
        allow delete: if false;
      }

      // ---------- Avisos ----------

      function isValidNotice(data) {
        return hasExactly(data, ['title', 'body', 'source', 'sourceDetail', 'date', 'pinned', 'deletedAt', 'createdAt', 'updatedAt'])
          && isText(data.title, 3, 120)
          && isText(data.body, 1, 2000)
          && data.source in ['lideres', 'professor']
          && isText(data.sourceDetail, data.source == 'professor' ? 2 : 0, 80)
          && isDate(data.date)
          && data.pinned is bool
          && hasTimestamps(data);
      }

      match /notices/{id} {
        allow read: if canRead(t);
        allow create: if isValidCreate(t) && isValidNotice(request.resource.data);
        allow update: if isValidLeaderUpdate(t) && isValidNotice(request.resource.data);
        allow delete: if false;
      }

      // ---------- Eventos ----------

      function isValidEvent(data) {
        return data.keys().hasOnly(['type', 'title', 'description', 'date', 'time', 'link', 'deletedAt', 'createdAt', 'updatedAt'])
          && data.keys().hasAll(['type', 'title', 'description', 'date', 'link', 'deletedAt', 'createdAt', 'updatedAt'])
          && data.type in ['lab', 'workshop', 'palestra', 'outro']
          && isText(data.title, 3, 120)
          && isText(data.description, 1, 280)
          && isDate(data.date)
          && isTime(data.get('time', ''))
          && isLink(data.link, false)
          && hasTimestamps(data);
      }

      match /events/{id} {
        allow read: if canRead(t);
        allow create: if isValidCreate(t) && isValidEvent(request.resource.data);
        allow update: if isValidLeaderUpdate(t) && isValidEvent(request.resource.data);
        allow delete: if false;
      }

      // ---------- Oportunidades (vagas, estágios, bolsas…) ----------

      function isValidOpportunity(data) {
        return hasExactly(data, ['kind', 'title', 'org', 'description', 'deadline', 'link', 'deletedAt', 'createdAt', 'updatedAt'])
          && data.kind in ['estagio', 'pesquisa', 'bolsa', 'competicao', 'outro']
          && isText(data.title, 3, 120)
          && isText(data.org, 0, 80)
          && isText(data.description, 1, 500)
          && isDate(data.deadline)
          && isLink(data.link, false)
          && hasTimestamps(data);
      }

      match /opportunities/{id} {
        allow read: if canRead(t);
        allow create: if isValidCreate(t) && isValidOpportunity(request.resource.data);
        allow update: if isValidLeaderUpdate(t) && isValidOpportunity(request.resource.data);
        allow delete: if false;
      }

      // ---------- Arquivos (só links: OneDrive, Teams, Drive…) ----------

      function isValidFile(data) {
        return hasExactly(data, ['title', 'category', 'subject', 'link', 'deletedAt', 'createdAt', 'updatedAt'])
          && isText(data.title, 3, 120)
          && data.category in ['slides', 'lista', 'gabarito', 'material', 'outro']
          && isSubject(t, data.subject, true)
          && isLink(data.link, true)
          && hasTimestamps(data);
      }

      match /files/{id} {
        allow read: if canRead(t);
        allow create: if isValidCreate(t) && isValidFile(request.resource.data);
        allow update: if isValidLeaderUpdate(t) && isValidFile(request.resource.data);
        allow delete: if false;
      }
    }

    // Qualquer outro caminho fica bloqueado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
